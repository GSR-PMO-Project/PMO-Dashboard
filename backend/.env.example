# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key - bypasses RLS, keep this on the server only, never ship it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Origin of the admin dashboard frontend, for CORS
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# SMTP settings for sending VIP invitation emails (e.g. Hostinger email hosting)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=PMO Dashboard
SMTP_FROM_EMAIL=
