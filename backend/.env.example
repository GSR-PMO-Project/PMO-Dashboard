# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key - bypasses RLS, keep this on the server only, never ship it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Origin of the admin dashboard frontend, for CORS
FRONTEND_ORIGIN=http://localhost:5173

PORT=4000

# Resend settings for sending VIP invitation emails
RESEND_API_KEY=
RESEND_FROM_NAME=PMO Dashboard
RESEND_FROM_EMAIL=

# Secret Vercel Cron sends as "Authorization: Bearer <value>" to trigger /cron/sync-vip-roles.
# Must match the CRON_SECRET env var set in the Vercel project settings.
CRON_SECRET=
